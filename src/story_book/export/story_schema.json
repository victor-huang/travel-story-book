{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/victor-huang/travel-story-book/story.schema.json",
  "title": "story-book AI response",
  "description": "The structured half of the model's answer: what a renderer consumes. Shipped inside every package as schema/story.schema.json and checked by `story-book check-story`, which also resolves every asset_id and event_id against the manifest. A first real run produced a richer but non-conformant document -- no source_event_ids, video_scenes renamed, layout_pages absent -- which is why the contract is now published rather than only described in prose.",
  "type": "object",
  "required": ["schema_version", "days", "chapters", "captions", "uncertainties"],
  "properties": {
    "schema_version": { "type": ["integer", "string"] },
    "title": { "type": "string" },
    "narrative_voice": { "type": "string" },
    "days": {
      "description": "One entry per day covered. A package may be handed over a day at a time or all at once; either way the response says which days it speaks for.",
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["date", "narrative"],
        "properties": {
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "narrative": { "type": "string" },
          "summary": { "type": "string" }
        }
      }
    },
    "chapters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["chapter_id", "date", "title", "narrative", "asset_ids", "source_event_ids"],
        "properties": {
          "chapter_id": { "type": "string" },
          "date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "title": { "type": "string" },
          "narrative": { "type": "string" },
          "starts_at": { "type": "string" },
          "asset_ids": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string" }
          },
          "source_event_ids": {
            "description": "Which detected clusters this chapter drew from. Required: it is the only link back from an editorial unit to the pipeline's own grouping, and without it a renderer cannot tell which cluster a chapter reorganised.",
            "type": "array",
            "items": { "type": "string" }
          },
          "uncertainties": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "captions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "caption"],
        "properties": {
          "asset_id": { "type": "string" },
          "caption": { "type": "string" }
        }
      }
    },
    "layout_pages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["page", "hero_asset_id", "asset_ids"],
        "properties": {
          "page": { "type": "integer", "minimum": 1 },
          "hero_asset_id": { "type": "string" },
          "asset_ids": { "type": "array", "items": { "type": "string" } },
          "note": { "type": "string" }
        }
      }
    },
    "video_scenes": {
      "description": "One entry per clip used. Source ranges are estimates unless the package shipped playable proxies; say so in uncertainties when they are.",
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "role", "source_start_seconds", "source_end_seconds"],
        "properties": {
          "asset_id": { "type": "string" },
          "role": { "type": "string" },
          "source_start_seconds": { "type": "number", "minimum": 0 },
          "source_end_seconds": { "type": "number", "minimum": 0 },
          "timeline_duration_seconds": { "type": "number", "minimum": 0 },
          "note": { "type": "string" }
        }
      }
    },
    "uncertainties": {
      "description": "Anything inferred rather than read, including landmarks named from a photograph rather than from metadata. Not optional politeness -- it is how a reader knows which claims to check.",
      "type": "array",
      "items": { "type": ["string", "object"] }
    },
    "requested_additional_context": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
